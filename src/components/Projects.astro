---
import Html from "./Html.astro";
import Css from "./Css.astro";
import Javascript from "./Javascript.astro";
import Bootstrap from "./Bootstrap.astro";
import Tailwind from "./Tailwind.astro";
import Typescript from "./Typescript.astro";
import React from "./React.astro";

const TAGS = {
  HTML: {
    name: "HTML5",
    class: "bg-orange-400 text-white",
    icon: Html
  },
  CSS: {
    name: "CSS3",
    class: "bg-blue-400 text-white",
    icon: Css
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-yellow-400 text-black",
    icon: Javascript
  },
  BOOTSTRAP: {
    name: "Bootstrap",
    class: "bg-purple-400 text-white",
    icon: Bootstrap
  },
  TYPESCRIPT: {
    name: "typescript",
    class: "bg-blue-400 text-white",
    icon: Typescript
  },
  REACT: {
    name: "react",
    class: "bg-blue-400 text-white",
    icon: React
  },
  TAILWIND: {
    name: "tailwind",
    class: "bg-blue-400 text-white",
    icon: Tailwind
  },
}

const PROJECTS = [
  {
    title: "TrackFlow",
    description: "Proyecto personal realizado con la API de Spotify, proporciona listados de los Artistas, Canciones y Géneros mas escuchados tras hacer login en su cuenta de Spotify.<strong> Actualmente se encuentra en Modo Desarrollo por la API de Spotify y no funcionara si su cuenta no esta en la Whitelist, se ha mandado una solicitud para pasar al Modo de Cuota Extendida</strong>",
    technologies: [TAGS.REACT , TAGS.TYPESCRIPT, TAGS.TAILWIND],
    link: "https://trackflow.netlify.app",
    image: ["TrackFlow1.png","TrackFlow2.png","TrackFlow3.png"],
    github_available: true,
    github_link:"https://github.com/JorgeArmando3414/Spotify-API-project",
  },
  {
    title: "LionRig Studio",
    description: "Página Web realizada para LionRig Studio con un diseño que capta la identidad de la empresa a la vez que ofrece una agradable experiencia para el usuario.",
    technologies: [TAGS.HTML ,TAGS.BOOTSTRAP, TAGS.JAVASCRIPT],
    link: "https://www.lionrigstudio.com/",
    image: ["Lionrig1.png","Lionrig2.png","Lionrig3.png"],
    github_available: false,
    github_link:"",
  },
  {
    title: "GEOTRANSFER",
    description: "Página web del grupo de investigación geológica Geotransfer. Hecha a medida acorde a sus necesidades para compartir sus aportes y servicios con el resto de la comunidad científica.",
    technologies: [TAGS.HTML , TAGS.CSS, TAGS.JAVASCRIPT],
    link: "https://geotransfer.unizar.es",
    image: ["Geotransfer1.png","Geotransfer2.png","Geotransfer3.png"],
    github_available: false,
    github_link:"",
  },
];
---

<div class="flex flex-col gap-16">
  {
    PROJECTS.map((project) => (
      <div class="flex flex-col md:flex-row justify-between gap-8">
        <div class="flex flex-col w-full md:max-w-[40%] gap-4 justify-between">
          <h2 class="text-lg font-semibold text-green-500">{project.title}</h2>
          <h3 class="dark:text-gray-300" set:html={project.description}>{project.description}</h3>
          <nav class="flex flex-row gap-3">
            {project.technologies.map((technology) => (
              <technology.icon class="size-6"/>
          ))}
          </nav>
          <nav class="flex flex-row gap-3">
            <a
            target="_blank"
            rel="noreferrer noopener"
            href={project.link}
            class="flex flex-row gap-2 transition rounded-md dark:bg-black dark:border-gray-200 dark:text-white hover:bg-black bg-gray-200 border-[1px] border-gray-400 hover:border-gray-200 text-black hover:text-white dark:hover:bg-gray-200 dark:hover:border-gray-600 dark:hover:text-gray-800 text-center w-fit px-4 py-1 drop-shadow-lg items-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              />
            </svg>
            Link
            </a>
            {project.github_available &&
            (<a
            target="_blank"
            rel="noreferrer noopener"
            href={project.github_link}
            class="flex flex-row gap-2 transition rounded-md dark:bg-black dark:border-gray-200 dark:text-white hover:bg-black bg-gray-200 border-[1px] border-gray-400 hover:border-gray-200 text-black hover:text-white dark:hover:bg-gray-200 dark:hover:border-gray-600 dark:hover:text-gray-800 text-center w-fit px-4 py-1 drop-shadow-lg items-center"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 256 250"
              width="256"
              height="250"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="xMidYMid"
            >
              <path
                d="M128.001 0C57.317 0 0 57.307 0 128.001c0 56.554 36.676 104.535 87.535 121.46 6.397 1.185 8.746-2.777 8.746-6.158 0-3.052-.12-13.135-.174-23.83-35.61 7.742-43.124-15.103-43.124-15.103-5.823-14.795-14.213-18.73-14.213-18.73-11.613-7.944.876-7.78.876-7.78 12.853.902 19.621 13.19 19.621 13.19 11.417 19.568 29.945 13.911 37.249 10.64 1.149-8.272 4.466-13.92 8.127-17.116-28.431-3.236-58.318-14.212-58.318-63.258 0-13.975 5-25.394 13.188-34.358-1.329-3.224-5.71-16.242 1.24-33.874 0 0 10.749-3.44 35.21 13.121 10.21-2.836 21.16-4.258 32.038-4.307 10.878.049 21.837 1.47 32.066 4.307 24.431-16.56 35.165-13.12 35.165-13.12 6.967 17.63 2.584 30.65 1.255 33.873 8.207 8.964 13.173 20.383 13.173 34.358 0 49.163-29.944 59.988-58.447 63.157 4.591 3.972 8.682 11.762 8.682 23.704 0 17.126-.148 30.91-.148 35.126 0 3.407 2.304 7.398 8.792 6.14C219.37 232.5 256 184.537 256 128.002 256 57.307 198.691 0 128.001 0Zm-80.06 182.34c-.282.636-1.283.827-2.194.39-.929-.417-1.45-1.284-1.15-1.922.276-.655 1.279-.838 2.205-.399.93.418 1.46 1.293 1.139 1.931Zm6.296 5.618c-.61.566-1.804.303-2.614-.591-.837-.892-.994-2.086-.375-2.66.63-.566 1.787-.301 2.626.591.838.903 1 2.088.363 2.66Zm4.32 7.188c-.785.545-2.067.034-2.86-1.104-.784-1.138-.784-2.503.017-3.05.795-.547 2.058-.055 2.861 1.075.782 1.157.782 2.522-.019 3.08Zm7.304 8.325c-.701.774-2.196.566-3.29-.49-1.119-1.032-1.43-2.496-.726-3.27.71-.776 2.213-.558 3.315.49 1.11 1.03 1.45 2.505.701 3.27Zm9.442 2.81c-.31 1.003-1.75 1.459-3.199 1.033-1.448-.439-2.395-1.613-2.103-2.626.301-1.01 1.747-1.484 3.207-1.028 1.446.436 2.396 1.602 2.095 2.622Zm10.744 1.193c.036 1.055-1.193 1.93-2.715 1.95-1.53.034-2.769-.82-2.786-1.86 0-1.065 1.202-1.932 2.733-1.958 1.522-.03 2.768.818 2.768 1.868Zm10.555-.405c.182 1.03-.875 2.088-2.387 2.37-1.485.271-2.861-.365-3.05-1.386-.184-1.056.893-2.114 2.376-2.387 1.514-.263 2.868.356 3.061 1.403Z"
              ></path>
            </svg>
            Github
            </a>)}
          </nav>
        </div>
        {/* <img src={project.image} alt="descripcion del proyecto" /> */}
        <div id="default-carousel" class="relative w-full md:w-[55%] " data-carousel="static">
          <!-- Carousel wrapper -->
          <div class="relative h-56 overflow-hidden rounded-lg md:h-80">
              <!-- Item 1 -->
              <div class="hidden duration-700 ease-in-out" data-carousel-item>
                  <img src={project.image[0]} class="absolute block w-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2" alt={project.description}>
              </div>
              <!-- Item 2 -->
              <div class="hidden duration-700 ease-in-out" data-carousel-item>
                  <img src={project.image[1]} class="absolute block w-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2" alt={project.description}>
              </div>
              <!-- Item 3 -->
              <div class="hidden duration-700 ease-in-out" data-carousel-item>
                  <img src={project.image[2]} class="absolute block w-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2" alt={project.description}>
              </div>
          </div>
          <!-- Slider controls -->
          <button type="button" class="absolute top-0 start-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none" data-carousel-prev>
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-gray-500/30 dark:bg-gray-800/30  group-hover:bg-gray-800/60 group-focus:outline-none">
                  <svg class="w-4 h-4 text-white  rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4"/>
                  </svg>
                  <span class="sr-only">Previous</span>
              </span>
          </button>
          <button type="button" class="absolute top-0 end-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none" data-carousel-next>
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-gray-800/30 group-hover:bg-gray-800/60 group-focus:outline-none">
                  <svg class="w-4 h-4 text-white  rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                  </svg>
                  <span class="sr-only">Next</span>
              </span>
          </button>
        </div>
      </div>
    ))
  }
</div>
